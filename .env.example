# Copy this file to .env and fill in your own values. Never commit .env.

# AIS Stream API key — create at https://aisstream.io/account
AISSTREAM_API_KEY=your_key_here

# VesselAPI key (candidate source for Hormuz) — create at https://dashboard.vesselapi.com/
VESSELAPI_KEY=your_key_here
# VesselAPI box: latBottom,latTop,lonLeft,lonRight — |dLat|+|dLon| must be <= 4.
# Temporary box around the strait narrows; Person B decides the real gate area.
VESSELAPI_BBOX=26.0,26.9,56.0,56.9

# Subscription bounding box: two corners [lat, lon].
# TEMPORARY wide box around the Strait of Hormuz, only for testing whether data arrives.
# Person B owns the exact region and gate definitions.
BBOX_LAT_1=27.5
BBOX_LON_1=55.0
BBOX_LAT_2=25.0
BBOX_LON_2=58.0

# Person B's detector and gate (lon1,lat1,lon2,lat2) — leave empty until B confirms
DETECTOR=
GATE_COORDINATES=

# SQLite file path
DB_PATH=hormuz_watch.db

# Azure SQL Database (live pipeline -> Power BI). Real values only in .env, never in code/Git.
AZURE_SQL_SERVER=your_server.database.windows.net
AZURE_SQL_DATABASE=your_database
AZURE_SQL_USER=your_sql_login
AZURE_SQL_PASSWORD=your_password
